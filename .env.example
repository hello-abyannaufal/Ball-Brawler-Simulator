# Copy to .env and adjust. All placeholders are non-secret examples (Req 1.7).

# --- PostgreSQL (used by docker-compose and the app) ---
POSTGRES_USER=ballbrawler
POSTGRES_PASSWORD=ballbrawler
POSTGRES_DB=ballbrawler
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Connection string consumed by Drizzle and the db:migrate script.
# Must match the POSTGRES_* values above.
DATABASE_URL=postgres://ballbrawler:ballbrawler@127.0.0.1:5432/ballbrawler

# --- Auth_Service (nuxt-auth-utils) ---
# Session cookie encryption password. Minimum 32 characters.
# Generate a real random value for any non-local use.
NUXT_SESSION_PASSWORD=change-me-to-a-random-32-char-string
